# 복사해서 .env로 쓴다. EXPO_PUBLIC_ 값은 앱에 그대로 들어가므로 비밀값을 넣지 않는다.
# Android 에뮬레이터에서 로컬 API를 쓰려면 먼저 실행한다: adb reverse tcp:3000 tcp:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
# 업데이트 안내 화면의 버튼이 여는 스토어의 앱 페이지. 스토어에 앱을 등록한 뒤 채운다. 없으면 버튼이 보이지 않는다.
# EXPO_PUBLIC_IOS_STORE_URL=
# EXPO_PUBLIC_ANDROID_STORE_URL=
# 동의 화면의 [전문 보기]가 여는 주소. 문서를 올린 뒤 채운다(D-A5). 없으면 [전문 보기]가 보이지 않는다.
# EXPO_PUBLIC_TERMS_URL=
# EXPO_PUBLIC_PRIVACY_URL=
# EXPO_PUBLIC_HEALTH_DATA_URL=
# 로그인(T-106). 모두 공개되어도 되는 값이다. 없으면 로그인 버튼이 "로그인하지 못했어요"를 보여 준다
# Supabase 대시보드 > Project Settings > API Keys의 프로젝트 주소와 Publishable 키
# EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Google Cloud의 OAuth 클라이언트 ID(웹, iOS)
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# iOS 클라이언트의 "iOS URL 스킴"(com.googleusercontent.apps.로 시작). 앱 설정에만 쓰이며, 바꾸면 개발 빌드를 다시 만든다
# GOOGLE_IOS_URL_SCHEME=
