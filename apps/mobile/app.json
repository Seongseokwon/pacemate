{
  "expo": {
    "name": "PaceMate",
    "slug": "pacemate",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pacemate",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B1018",
    "ios": {
      "bundleIdentifier": "com.pacemate.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.pacemate.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications"
    ]
  }
}
