{
  "expo": {
    "name": "PaceMate",
    "slug": "pacemate",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pacemate",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B1018",
    "ios": {
      "bundleIdentifier": "com.pacemate.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.pacemate.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      ["@kingstinct/react-native-healthkit", { "NSHealthShareUsageDescription": "러닝 날짜, 거리, 시간과 심박수를 읽어 운동 기록을 저장하고 훈련에 연결합니다. 광고에는 사용하지 않습니다.", "NSHealthUpdateUsageDescription": false, "background": false }]
    ]
  }
}
