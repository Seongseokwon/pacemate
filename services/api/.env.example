# 로컬 실행용 예시. 복사해서 .env로 쓴다. 실제 값은 저장소에 넣지 않는다.
PORT=3000
# 로컬 DB는 저장소 루트에서 docker compose up -d 로 띄운다
DATABASE_URL=postgresql://pacemate:pacemate@localhost:5433/pacemate
# 인증 서비스(Supabase)의 공개 키 주소와 토큰 발급자
AUTH_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
AUTH_ISSUER=https://<project-ref>.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated
# 계정 삭제 때 인증 서비스의 사용자를 지우는 데 쓴다(T-106). Secret 키는 비밀값이다. 없으면 계정 삭제가 끝나지 않는다
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=
# 체험분 식별 해시용 비밀값(32자 이상). 운영 중 변경하면 기존 체험분을 찾지 못한다
# IDENTITY_HASH_SECRET=
# LLM 공급자(T-407). LLM_PROVIDER가 없으면 채팅이 "AI 응답 실패"로 답한다. API 키는 비밀값이다
# LLM_PROVIDER=anthropic          # anthropic 또는 openai
# LLM_MODEL=                      # 공급자를 비교한 뒤 정한다(D-03). 예: claude-opus-5-5
# LLM_EFFORT=low                  # Claude: low~max(기본 low). GPT: 추론 모델의 reasoning_effort
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# 단가 표(src/chat/llm/pricing.ts)에 없는 모델의 단가(USD / 100만 토큰). GPT 모델은 넣어야 서버가 뜬다
# LLM_INPUT_USD_PER_MTOK=
# LLM_OUTPUT_USD_PER_MTOK=
# LLM_CACHED_INPUT_USD_PER_MTOK=
# 이 버전보다 낮은 앱은 업데이트 안내를 받는다
MIN_APP_VERSION=1.0.0
# 구독 서비스 웹훅과 예약 실행기가 보내는 비밀값(32자 이상, 서로 다른 값). 없으면 그 경로는 모든 요청을 거절한다
# 만들기: openssl rand -hex 32
# SUBSCRIPTION_WEBHOOK_SECRET=
# INTERNAL_JOB_SECRET=
