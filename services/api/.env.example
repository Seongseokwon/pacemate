# 로컬 실행용 예시. 복사해서 .env로 쓴다. 실제 값은 저장소에 넣지 않는다.
PORT=3000
# 로컬 DB는 저장소 루트에서 docker compose up -d 로 띄운다
DATABASE_URL=postgresql://pacemate:pacemate@localhost:5433/pacemate
# 인증 서비스(Supabase)의 공개 키 주소와 토큰 발급자
AUTH_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
AUTH_ISSUER=https://<project-ref>.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated
# 이 버전보다 낮은 앱은 업데이트 안내를 받는다
MIN_APP_VERSION=1.0.0
# 구독 서비스 웹훅과 예약 실행기가 보내는 비밀값(32자 이상, 서로 다른 값). 없으면 그 경로는 모든 요청을 거절한다
# 만들기: openssl rand -hex 32
# SUBSCRIPTION_WEBHOOK_SECRET=
# INTERNAL_JOB_SECRET=
